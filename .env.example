# Copy to .env.local. Never commit real values. Every variable here is server-only:
# none may be renamed to NEXT_PUBLIC_*.
# TradeD reads the same database and server-side Dhan token as TradeM.
# Do not put the Dhan access token in this file if it is already saved in Admin → Markets.

DATABASE_URL=
DATABASE_URL_UNPOOLED=

MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
MARKET_DATA_MODE=
# Defaults to true. Set to false to stop live feed and broker market reads.
MARKET_DATA_ENABLED=

# Optional. Required only for live account reads (funds, positions, holdings, orders).
# DHAN_CLIENT_ID=
# Optional alternative to the token saved in Admin → Markets.
# DHAN_ACCESS_TOKEN=

# Optional index id used by the existing options chain reader.
# NIFTY_DHAN_SECURITY_ID=13

APP_URL=

# Encrypts per-account broker credentials (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes stored broker credentials unreadable; holders would reconnect.
ENCRYPTION_KEY=
# Set only while rotating: the old key, kept for decryption.
# ENCRYPTION_KEY_PREVIOUS=

# Live broker orders. All three must be set AND every compliance requirement met; until then
# the server refuses live orders whatever LIVE_ORDERS_ENABLED says.
LIVE_ORDERS_ENABLED=false
# HTTPS URL of the static-IP execution worker, and a shared secret of at least 32 characters.
# EXECUTION_SERVICE_URL=
# EXECUTION_SERVICE_SECRET=
